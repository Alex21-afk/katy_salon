Options -Indexes
RewriteEngine On

RewriteRule ^assets/(.*)$ public/assets/$1 [L]
RewriteRule ^(sw\.js|manifest\.json)$ public/$1 [L]
RewriteRule ^uploads/(.*)$ app/storage/uploads/$1 [F,L]
RewriteRule ^app/ - [F,L]
RewriteRule ^db/ - [F,L]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ public/index.php [QSA,L]

<FilesMatch "^(config(\.example)?\.php|database\.sql|README\.md)$">
    Require all denied
</FilesMatch>